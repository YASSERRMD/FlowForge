# FlowForge local development configuration.
# Copy to .env and adjust. NEVER commit a real .env or real secrets.

# Public address of the web app (used for CORS and links)
WEB_PUBLIC_URL=http://localhost:3000

# Go API service
API_ADDR=127.0.0.1:8080
# Comma-separated list of origins allowed to call the API and open WebSockets
API_ALLOWED_ORIGINS=http://localhost:3000
# "development" enables the explicit dev login flow; "production" requires real sessions
APP_ENV=development

# PostgreSQL (authoritative store)
DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge?sslmode=disable

# Redis (transient notifications only)
REDIS_URL=redis://localhost:6379/0

# Worker
WORKER_ID=worker-local-1
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL_MS=250

# Session cookie signing secret — replace with a random 32+ byte value in any
# real deployment. This placeholder is intentionally invalid for production.
SESSION_SECRET=dev-only-insecure-secret-change-me

# HTTP server tuning (milliseconds / kilobytes)
HTTP_READ_TIMEOUT_MS=30000
HTTP_WRITE_TIMEOUT_MS=60000
HTTP_MAX_BODY_KB=1024

# Development-only auth bypass. Never enable outside local development;
# config validation rejects this in production.
AUTH_DEV_MODE=true
